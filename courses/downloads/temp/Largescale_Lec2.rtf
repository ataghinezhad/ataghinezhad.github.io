}\pard\plain\ltrpar\s1\li540\fi-540\loch\af4\dbch\f2\fs34\cf4\lang1033\li0\fi0\qc {\b\dbch\af3\loch\f3\fs56\cf1 Scenario #4: Hidden Shared Failure Types}{\b\shad\f1\fs80\cf1 \par 
